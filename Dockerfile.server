FROM oven/bun:latest

# Install Python 3 (for document tools), curl (for health checks), coreutils (for stdbuf)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy ALL workspace package.json files for layer-cached dependency install.
# bun install resolves the workspace glob (packages/*, apps/*) so every
# package.json referenced by the root workspaces config must be present.
COPY package.json bun.lock ./
COPY packages/core/package.json packages/core/
COPY packages/shared/package.json packages/shared/
COPY packages/server-core/package.json packages/server-core/
COPY packages/server/package.json packages/server/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/ui/package.json packages/ui/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/session-mcp-server/package.json packages/session-mcp-server/
COPY apps/electron/package.json apps/electron/
COPY apps/web/package.json apps/web/
COPY apps/cli/package.json apps/cli/
COPY apps/viewer/package.json apps/viewer/

# Install deps (--ignore-scripts: husky/postinstall hooks fail without git)
RUN bun install --ignore-scripts

# Copy source code (only what the server needs at runtime)
COPY packages/ packages/
COPY apps/electron/ apps/electron/
COPY scripts/start-server.sh scripts/start-server.sh

# Build subprocess servers (the runtime resolver looks for dist/index.js)
RUN cd packages/pi-agent-server && bun build src/index.ts --outdir=dist --target=bun --format=esm --external koffi
RUN cd packages/session-mcp-server && bun build src/index.ts --outdir=dist --target=node --format=cjs

# Create non-root user — Claude Code SDK refuses --dangerously-skip-permissions as root
RUN groupadd --gid 1001 craft && \
    useradd --uid 1001 --gid craft --shell /bin/sh --create-home craft

# Pre-create data directories with correct ownership
# All paths must be consistent:
#   homedir()/.craft-agent = /data/.craft-agent (credentials.enc)
#   CRAFT_CONFIG_DIR       = /data/.craft-agent (config.json)
#   CRAFT_DATA_DIR         = /data/.craft-agent (workspaces/)
RUN mkdir -p /data/.craft-agent/workspaces && \
    chown -R craft:craft /data && \
    chown -R craft:craft /app && \
    chmod +x scripts/start-server.sh

# Environment defaults — Railway overrides PORT automatically
ENV CRAFT_BUNDLED_ASSETS_ROOT=/app/apps/electron
ENV CRAFT_IS_PACKAGED=false
ENV CRAFT_DATA_DIR=/data/.craft-agent
ENV CRAFT_CONFIG_DIR=/data/.craft-agent
ENV CRAFT_RPC_HOST=0.0.0.0
ENV PORT=9100
ENV NODE_ENV=production
ENV HOME=/data

# Switch to non-root user
USER craft

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
    CMD curl -sf http://localhost:${PORT}/health || exit 1

EXPOSE 9100

# Start via wrapper script for diagnostics and env setup
ENTRYPOINT ["scripts/start-server.sh"]
