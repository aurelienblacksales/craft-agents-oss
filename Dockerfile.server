FROM oven/bun:latest

# Install Python 3 (for document tools) and curl (for health checks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy ALL workspace package.json files for layer-cached dependency install.
# bun install resolves the workspace glob (packages/*, apps/*) so every
# package.json referenced by the root workspaces config must be present.
COPY package.json bun.lock ./
COPY packages/core/package.json packages/core/
COPY packages/shared/package.json packages/shared/
COPY packages/server-core/package.json packages/server-core/
COPY packages/server/package.json packages/server/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/ui/package.json packages/ui/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/session-mcp-server/package.json packages/session-mcp-server/
COPY apps/electron/package.json apps/electron/
COPY apps/web/package.json apps/web/
COPY apps/cli/package.json apps/cli/
COPY apps/viewer/package.json apps/viewer/

# Install deps (--ignore-scripts: husky/postinstall hooks fail without git)
RUN bun install --ignore-scripts

# Copy source code (only what the server needs at runtime)
COPY packages/ packages/
COPY apps/electron/ apps/electron/

# Pre-create data directories
RUN mkdir -p /data/craft-agent/workspaces

# Environment defaults — Railway overrides PORT automatically
ENV CRAFT_BUNDLED_ASSETS_ROOT=/app/apps/electron
ENV CRAFT_IS_PACKAGED=false
ENV CRAFT_DATA_DIR=/data/craft-agent
ENV CRAFT_RPC_HOST=0.0.0.0
ENV NODE_ENV=production

# Health check (uses curl installed above)
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost:${PORT:-9100}/health || exit 1

EXPOSE 9100

# Use stdbuf to prevent stdout buffering in Docker (critical for Claude Agent SDK)
# Use shell form so PORT env var is resolved at runtime for CRAFT_RPC_PORT
ENTRYPOINT ["/bin/sh", "-c", "CRAFT_RPC_PORT=${PORT:-9100} exec stdbuf -oL bun run packages/server/src/index.ts"]
