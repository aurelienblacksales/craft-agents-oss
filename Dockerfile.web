# Dockerfile for Craft Agent web client
# Builds the Vite app and serves with nginx

# --- Build stage ---
FROM oven/bun:1 AS build

WORKDIR /app

# Copy package files for caching
COPY package.json bun.lock bunfig.toml ./
COPY packages/core/package.json packages/core/
COPY packages/shared/package.json packages/shared/
COPY packages/server-core/package.json packages/server-core/
COPY packages/server/package.json packages/server/
COPY packages/ui/package.json packages/ui/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/session-mcp-server/package.json packages/session-mcp-server/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY apps/cli/package.json apps/cli/
COPY apps/viewer/package.json apps/viewer/
COPY apps/web/package.json apps/web/
COPY apps/electron/package.json apps/electron/

RUN bun install --frozen-lockfile --ignore-scripts

COPY . .

# Build the web app
RUN bun run vite build --config apps/web/vite.config.ts

# --- Serve stage ---
FROM nginx:alpine

# Copy built assets
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

# Nginx config template — envsubst runs automatically at startup via
# the official nginx entrypoint (20-envsubst-on-templates.sh)
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Default env values for the WebSocket proxy target
# Override via Railway dashboard (e.g., craft-agent-server.railway.internal)
ENV CRAFT_SERVER_HOST=craft-agent-server.railway.internal
ENV CRAFT_SERVER_PORT=9100

EXPOSE 80
