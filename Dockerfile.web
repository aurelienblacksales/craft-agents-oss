# Stage 1: Build the web client
FROM oven/bun:latest AS build

WORKDIR /app

# Copy ALL workspace package.json files (bun install resolves workspace globs)
COPY package.json bun.lock ./
COPY packages/core/package.json packages/core/
COPY packages/shared/package.json packages/shared/
COPY packages/server-core/package.json packages/server-core/
COPY packages/server/package.json packages/server/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/ui/package.json packages/ui/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/session-mcp-server/package.json packages/session-mcp-server/
COPY apps/electron/package.json apps/electron/
COPY apps/web/package.json apps/web/
COPY apps/cli/package.json apps/cli/
COPY apps/viewer/package.json apps/viewer/

RUN bun install --ignore-scripts

# Copy root tsconfig (packages/ui/tsconfig.json extends ../../tsconfig.json)
COPY tsconfig.json ./

# Copy all source (needed for packages/* imports)
COPY packages/ packages/
COPY apps/web/ apps/web/
COPY apps/electron/src/shared/ apps/electron/src/shared/

# Build the web client
RUN bunx vite build --config apps/web/vite.config.ts

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built files
COPY --from=build /app/apps/web/dist/ /usr/share/nginx/html/

# nginx config with WebSocket proxy
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
